# Copy to .env.local for local development, and add the same values
# in Vercel > Project > Settings > Environment Variables for production.

# Your live site URL (used for sitemap, canonical URL and social sharing).
# On Vercel this is optional: the production domain is detected automatically.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend (https://resend.com, free tier available).
# Without these two values the form validates input but tells visitors it is
# not connected yet. It never pretends a message was delivered.
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's shared test sender, which can only deliver
# to the email address that owns your Resend account. Use a verified domain
# sender such as "Lamisa <hello@your-domain.com>" for general use.
CONTACT_FROM_EMAIL=
